# Copy to .env and fill in. Never commit .env.
BALEBOT_DATABASE_URL=sqlite+aiosqlite:///./balebot.db
# production: postgresql+asyncpg://balebot:CHANGE_ME@127.0.0.1:5432/balebot
BALEBOT_BALE_TOKEN=
BALEBOT_WEBHOOK_BASE_URL=https://roditeam.ir
BALEBOT_WEBHOOK_SECRET=
BALEBOT_BASE_MODEL_API_KEY=
BALEBOT_DEFAULT_BASE_URL=https://api.z.ai/api/paas/v4
BALEBOT_DEFAULT_BASE_MODEL=glm-4.7-flash
BALEBOT_DEFAULT_DAILY_QUOTA=100
# personal keys: generate with `python -m balebot.cli gen-vault-key`, keep a backup outside the server
BALEBOT_VAULT_KEY=
# panel sessions: long random string; keep cookie_secure=true behind HTTPS
BALEBOT_SESSION_SECRET=
BALEBOT_COOKIE_SECURE=true

# --- agent sandbox (see docs/operations.md; leave off until deploy/verify-isolation.sh passes) ---
BALEBOT_SANDBOX_ENABLED=false
# 16+ random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
BALEBOT_PROXY_SECRET=
BALEBOT_PROXY_URL=http://10.77.0.1:8001/v1
# BALEBOT_INCUS_PROJECT=balebot
# BALEBOT_SANDBOX_IMAGE=agent-base
# BALEBOT_SANDBOX_DISK=3GiB            # must equal the template's root size
# BALEBOT_AGENT_COST=5
# BALEBOT_AGENT_TIMEOUT=600
# BALEBOT_AGENT_MAX_CONCURRENT=3
# BALEBOT_AGENT_TOOLSETS=
