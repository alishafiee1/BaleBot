[Unit]
Description=BaleBot (Bale webhook + admin panel)
After=network-online.target incus.service
Wants=network-online.target

[Service]
User=balebot
Group=balebot
WorkingDirectory=/opt/balebot
EnvironmentFile=/etc/balebot/env
Environment=INCUS_CONF=/etc/balebot/incus
ExecStart=/opt/balebot/.venv/bin/uvicorn balebot.main:app_factory --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# hardening: the bot must not be able to change its own code or touch the rest of the system
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/balebot

[Install]
WantedBy=multi-user.target
