[Unit]
Description=BaleBot: stop idle sandboxes and destroy old ones
After=incus.service

[Service]
Type=oneshot
User=balebot
Group=balebot
WorkingDirectory=/opt/balebot
EnvironmentFile=/etc/balebot/env
Environment=INCUS_CONF=/etc/balebot/incus
ExecStart=/opt/balebot/.venv/bin/python -m balebot.cli sandbox-reap
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/balebot
